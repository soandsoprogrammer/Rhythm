<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/lyrics_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_bg"
        android:tint="@color/lyrics_widget_surface" />

    <LinearLayout
        android:id="@+id/lyrics_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/lyrics_widget_title"
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/lyrics_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lyrics_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/lyrics_widget_subtext"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lyrics_widget_lines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lyrics_widget_previous_line"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/lyrics_widget_subtext"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_widget_current_line"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/rhythmlyricswidget_open_to_play"
                android:textColor="@color/lyrics_widget_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lyrics_widget_next_line"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/lyrics_widget_subtext"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
