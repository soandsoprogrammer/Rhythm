<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/lyrics_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_bg"
        android:tint="@color/lyrics_widget_surface" />

    <LinearLayout
        android:id="@+id/lyrics_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/lyrics_widget_title"
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/lyrics_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lyrics_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/lyrics_widget_subtext"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lyrics_widget_lines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lyrics_widget_previous_line"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/lyrics_widget_subtext"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_widget_current_line"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/rhythmlyricswidget_open_to_play"
                android:textColor="@color/lyrics_widget_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lyrics_widget_next_line"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/lyrics_widget_subtext"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyrics_widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/lyrics_widget_previous"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/animatedplaybackcontrols_previous">

                <ImageView
                    android:id="@+id/lyrics_widget_previous_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_preview_circle"
                    android:tint="@color/lyrics_widget_tertiary" />

                <ImageView
                    android:id="@+id/lyrics_widget_previous_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="@color/lyrics_widget_on_tertiary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/lyrics_widget_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/lyrics_widget_play_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_preview_pill"
                    android:tint="@color/lyrics_widget_primary" />

                <ImageView
                    android:id="@+id/lyrics_widget_play_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/lyrics_widget_on_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/lyrics_widget_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/onboarding_next">

                <ImageView
                    android:id="@+id/lyrics_widget_next_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_preview_circle"
                    android:tint="@color/lyrics_widget_tertiary" />

                <ImageView
                    android:id="@+id/lyrics_widget_next_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/lyrics_widget_on_tertiary" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
